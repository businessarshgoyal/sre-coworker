# All optional. Leave unset to run fully in dry-run mode.
SRE_DRY_RUN=true
SRE_GITHUB_REPO=acme/payments-api
SRE_GITHUB_TOKEN=
SRE_JIRA_BASE_URL=https://acme.atlassian.net
SRE_JIRA_EMAIL=
SRE_JIRA_API_TOKEN=
SRE_JIRA_PROJECT_KEY=ENG
SRE_DEVIN_API_KEY=

# Ingestion: pull from a queue (recommended) ...
SRE_QUEUE_BACKEND=redis            # pubsub | sqs | redis
SRE_PUBSUB_PROJECT=
SRE_PUBSUB_SUBSCRIPTION=
SRE_SQS_QUEUE_URL=
SRE_SQS_REGION=
SRE_REDIS_URL=redis://localhost:6379/0
SRE_REDIS_STREAM=alerts
# ... or a signed webhook (disabled when empty)
SRE_WEBHOOK_SECRET=
